<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fresh-database bootstrap for Render. Built against the same Core package
       the API ships with (packed by build.sh into the private local feed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>digitalmaktab-bootstrap</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DigitalMaktab.Core" Version="0.1.0-alpha" />
  </ItemGroup>
</Project>
