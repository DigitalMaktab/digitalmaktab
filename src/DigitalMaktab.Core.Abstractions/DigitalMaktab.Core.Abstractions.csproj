<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespaces here remain digitalmaktabapi.Models / .Headers so the split
         with DigitalMaktab.Core stays purely structural. Rename is a later step. -->
    <RootNamespace>DigitalMaktab.Core.Abstractions</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package metadata. Consumed by country modules and by the Api host. -->
  <PropertyGroup>
    <PackageId>DigitalMaktab.Core.Abstractions</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Digital Maktab</Authors>
    <Company>Digital Maktab</Company>
    <Description>Stable interfaces and entity POCOs for the Digital Maktab platform. Reference this from country modules and school plugins.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DigitalMaktab/digitalmaktab-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>digitalmaktab;school;education;afghanistan</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity POCOs live here and use [Table] / [Column] / [ForeignKey] attributes.
         PagedList<T> uses IQueryable extensions from EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
  </ItemGroup>

</Project>
