# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
*.DS_Store
.vscode
.editorconfig

# Claude Code runtime state (session-local, not for git)
.claude/

# DigitalMaktab Single Page Application
# dependencies
digitalmaktabspa/.vscode
digitalmaktabspa/node_modules
digitalmaktabspa/.pnp
digitalmaktabspa/.pnp.js

# testing
digitalmaktabspa/coverage

# production
digitalmaktabspa/build

# misc
digitalmaktabspa/.env.local
digitalmaktabspa/.env.development.local
digitalmaktabspa/.env.test.local
digitalmaktabspa/.env.production.local
.env*

digitalmaktabspa/npm-debug.log*
digitalmaktabspa/yarn-debug.log*
digitalmaktabspa/yarn-error.log*


# DigitalMaktab API (multi-project solution under src/)

# per-project build outputs
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/

# dev-only settings
src/DigitalMaktab.Api/appsettings.Development.json
src/DigitalMaktab.Api/.vscode

# runtime-generated resource subfolders (except the ones tracked)
src/DigitalMaktab.Core/Resources/*/
!src/DigitalMaktab.Core/Resources/Reports
!src/DigitalMaktab.Core/Resources/Localization

# local SQLite files if ever used
src/**/digitalmaktab*.db

# stale SPA build artifacts under Api's wwwroot — regenerated by `npm run build` in the SPA
src/DigitalMaktab.Api/wwwroot/**/*.jpg
src/DigitalMaktab.Api/wwwroot/**/*.jpeg

